# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Matches multiple files with brace expansion notation
[*.go]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true
charset = utf-8

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
charset = utf-8

[*.json]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
charset = utf-8

[*.yaml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
charset = utf-8

[*.yml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
charset = utf-8

[Makefile]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true
charset = utf-8
